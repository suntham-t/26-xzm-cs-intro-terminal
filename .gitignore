# 构建产物：exe 走 GitHub Release 分发，不进仓库（单文件 147MB 超 GitHub 100MB 限制）
app/dist/
*.exe
*.apk

# 开发/调试脚手架
_dev/
_shot-*.png
_probe_*.html
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 前端重设计的中间产物（源码分片在 _redesign/parts、shell.html、patches —— 那些要进仓库；
# 下面是可再生的：截图、基线副本、从补丁链生成的 JS、预览页）
_redesign/shots/
_redesign/baseline/
_redesign/src/app.js
_redesign/_probe*.js
_redesign/_p_*.js
_redesign/_shot*.png
web/_pv*.html
