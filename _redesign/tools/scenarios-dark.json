      "note": "在 #replIn 里设 value 再派发 Enter keydown（与真实敲键同一条代码路径），断言 #replOut 出现 2 // 深色：正式主题功能（html[data-theme=dark] + localStorage ic.theme.v1）",
      "steps": [
        {
          "desc": "dark theme on",
          "js": "document.documentElement.setAttribute(\"data-theme\",\"dark\");try{ localStorage.setItem(\"ic.theme.v1\",\"dark\"); }catch(e){} await __cap.sleep(600); return document.documentElement.getAttribute(\"data-theme\");"
        },
        {
          "desc": "close overlays",
          "js": "window.__IC__.closeAll(); await __cap.sleep(350);"
        },
        {
          "desc": "open repl",
          "js": "document.querySelector('#btnRepl').click(); await __cap.sleep(900); return !document.querySelector('#repl').hidden;"
        },
        {
          "desc": "run print(1+1)",
          "js": "var inp=document.querySelector('#replIn'); inp.focus(); inp.value='print(1+1)'; inp.dispatchEvent(new Event('input',{bubbles:true})); inp.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',keyCode:13,which:13,bubbles:true,cancelable:true})); await __cap.sleep(1600); return String(document.querySelector('#replOut').textContent||'').trim();"
        },
        {
          "desc": "assert output 2",
          "expect": "/2/.test(String(document.querySelector('#replOut').textContent||'')) && document.querySelectorAll('#replOut .rl-out').length > 0"
        }
      ]
    },
