{
  "defaults": {
    "viewport": [
      1280,
      880
    ],
    "settle": 1200,
    "beforeJs": "var IC = window.__IC__;\nIC.closeAll();\nawait __cap.sleep(250);\nif (!document.querySelector('#repl').hidden) { var rb=document.querySelector('#btnReplClose'); if (rb) { rb.click(); await __cap.sleep(350); } }\nvar wide = document.body.getAttribute('data-wide') === '1';\nvar toc = document.querySelector('#toc');\nif (wide && toc.hidden) { document.querySelector('#btnToc').click(); await __cap.sleep(450); }\nif (!wide && IC.UIDRAWER_STATE.open) { document.querySelector('#btnToc').click(); await __cap.sleep(450); }\nvar m = document.querySelector('main'); if (m) m.scrollTop = 0;\nvar tb = document.querySelector('#tocBody'); if (tb) tb.scrollTop = 0;\nawait __cap.sleep(200);\nreturn {replClosed: document.querySelector('#repl').hidden, tocHidden: toc.hidden, wide: wide};"
  },
  "scenarios": [
    {
      "name": "card@dark",
      "desc": "知识卡片 · 默认落地（点阵 + 目录 + 翻卡）（深色主题）",
      "viewport": [
        1280,
        880
      ],
      "shots": [
        {
          "w": 1280,
          "h": 880
        },
        {
          "w": 1500,
          "h": 1000
        }
      ],
      "note": "默认落地是第 1 章第 1 个知识点（点阵 1 / 3，#toc 在 1280 默认展开） // 深色：正式主题功能（html[data-theme=dark] + localStorage ic.theme.v1）",
      "steps": [
        {
          "desc": "dark theme on",
          "js": "document.documentElement.setAttribute(\"data-theme\",\"dark\");try{ localStorage.setItem(\"ic.theme.v1\",\"dark\"); }catch(e){} await __cap.sleep(600); return document.documentElement.getAttribute(\"data-theme\");"
        },
        {
          "desc": "close overlays",
          "js": "window.__IC__.closeAll(); await __cap.sleep(350);"
        },
        {
          "desc": "main scroll top",
          "js": "document.querySelector('main').scrollTop = 0; await __cap.sleep(300); return true;"
        },
        {
          "desc": "assert card",
          "expect": "!!document.querySelector('#card h2.cardTitle') && document.querySelector('#card h2.cardTitle').textContent.trim().length > 0 && document.querySelectorAll('#dots .dot').length > 0"
        }
      ]
    },
